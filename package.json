{
  "name": "@anyblades/blades",
  "version": "3.1.0-alpha.1",
  "style": "./src/blades.css",
  "exports": {
    ".": "./src/blades.css",
    "./pico": "./src/pico.css",
    "./pico/variables": "./src/pico/_variables.css",
    "./pico/layout": "./src/pico/layout/_index.css",
    "./pico/layout/*": "./src/pico/layout/_*.css",
    "./pico/content": "./src/pico/content/_index.css",
    "./pico/content/*": "./src/pico/content/_*.css",
    "./pico/forms": "./src/pico/forms/_index.css",
    "./pico/forms/*": "./src/pico/forms/_*.css",
    "./pico/components": "./src/pico/components/_index.css",
    "./pico/components/*": "./src/pico/components/_*.css",
    "./pico/utilities": "./src/pico/_utilities.css",
    "./standalone": "./src/blades.standalone.css",
    "./float-label": "./src/standalone/forms/_float-label.css",
    "./ninja": "./src/ninja.css",
    "./css/*.css": "./css/*.css",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "css/*.css",
    "_includes",
    ".prettierrc.json"
  ],
  "=== DEV ONLY": "Z-A",
  "scripts": {
    "build": "clear; npm run lint && npm run build:css && npm run build:minify && npm run build:conditional && npm run build:layered",
    "lint": "prettier --write --log-level silent './src/**/*.css'",
    "build:css": "postcss --config css './src/!(_)*.css' --dir css --no-map",
    "build:minify": "cleancss -O1 --with-rebase --batch --batch-suffix .min ./css/*.css !./css/*.min.css !./css/pico.conditional.* !./css/pico.layered.*",
    "build:conditional": "for f in '' .min; do { printf '@scope (.pico) {\\n'; cat ./css/pico${f}.css; printf '\\n}\\n'; } > ./css/pico.conditional${f}.css; done",
    "build:layered": "for f in '' .min; do { printf '@layer pico {\\n'; cat ./css/pico${f}.css; printf '\\n}\\n'; } > ./css/pico.layered${f}.css; done",
    "start": "npm run build:css -- --watch",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "tag": "next"
  },
  "devDependencies": {
    "autoprefixer": "^10.5.0",
    "clean-css-cli": "^5.4.2",
    "css-declaration-sorter": "^7.4.0",
    "postcss": "^8.4.33",
    "postcss-cli": "^12.0.0",
    "postcss-import": "^16.1.1",
    "postcss-nested": "^7.0.2",
    "prettier": "^3.5.3",
    "prettier-plugin-jinja-template": "^2.1.0"
  },
  "browserslist": [
    "defaults"
  ],
  "=== METADATA": "A-Z",
  "bugs": {
    "url": "https://github.com/anyblades/blades/issues"
  },
  "contributors": [
    "Lucas Larroche (https://picocss.com/)",
    "Anton Staroverov (https://blades.ninja/)"
  ],
  "description": "Fully compatible and actively maintained successor to Pico CSS.",
  "homepage": "https://blades.ninja/",
  "keywords": [
    "blades",
    "classless",
    "css-framework",
    "css",
    "dark-mode",
    "dark-theme",
    "lightweight",
    "minimal",
    "native-html",
    "semantic"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anyblades/blades.git"
  },
  "===": "==="
}

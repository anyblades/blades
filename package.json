{
  "name": "@anyblades/blades",
  "version": "3.1.0-beta.6",
  "style": "./css/blades.css",
  "exports": {
    ".": "./css/blades.css",
    "./compact": "./css/layered/compact.css",
    "./components": "./css/layered/components.css",
    "./components/*": "./css/layered/components/*.css",
    "./content": "./css/layered/content.css",
    "./content/*": "./css/layered/content/*.css",
    "./float-label/*": "./css/layered/forms/float-label/*.css",
    "./forms": "./css/layered/forms.css",
    "./forms/*": "./css/layered/forms/*.css",
    "./layout": "./css/layered/layout.css",
    "./layout/*": "./css/layered/layout/*.css",
    "./utilities": "./css/layered/utilities.css",
    "./variables": "./css/layered/variables.css",
    "./variables-blades": "./css/layered/variables-blades.css",
    "./src": "./src/blades.css",
    "./src/compact": "./src/blades/_compact.css",
    "./src/components": "./src/pico/components/_index.css",
    "./src/components/dropdown-popover": "./src/blades/components/_dropdown-popover.css",
    "./src/components/modal-modern": "./src/blades/components/_modal-modern.css",
    "./src/components/timeline": "./src/blades/components/_timeline.css",
    "./src/components/*": "./src/pico/components/_*.css",
    "./src/content": "./src/pico/content/_index.css",
    "./src/content/code-block": "./src/blades/content/_code-block.css",
    "./src/content/icon": "./src/blades/content/_icon.css",
    "./src/content/*": "./src/pico/content/_*.css",
    "./src/forms": "./src/pico/forms/_index.css",
    "./src/forms/float-label": "./src/blades/forms/float-label/_index.css",
    "./src/forms/float-label/*": "./src/blades/forms/float-label/_*.css",
    "./src/forms/*": "./src/pico/forms/_*.css",
    "./src/layout": "./src/pico/layout/_index.css",
    "./src/layout/columns": "./src/blades/layout/_columns.css",
    "./src/layout/*": "./src/pico/layout/_*.css",
    "./src/pico": "./src/pico.css",
    "./src/utilities": "./src/pico/_utilities.css",
    "./src/variables": "./src/pico/_variables.css",
    "./src/variables-blades": "./src/blades/_variables-blades.css",
    "./css/*.css": "./css/*.css",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "css/*.css",
    "css/layered",
    "_includes",
    "!_includes/node_modules",
    "!_includes/package-lock.json",
    ".prettierrc.json"
  ],
  "=== DEV ONLY": "Z-A",
  "scripts": {
    "build": "clear; npm run lint && npm run build:css && npm run build:minify && npm run build:conditional && npm run build:layered",
    "lint": "prettier --write --log-level silent './src/**/*.css'",
    "build:css": "for f in src/[!_]*.css; do RAYON_NUM_THREADS=1 lightningcss --bundle $f -o css/${f#src/} || exit 1; done",
    "build:minify": "for f in css/*.css; do case $f in *.min.css|css/pico.conditional.*) ;; *) lightningcss --minify $f -o ${f%.css}.min.css || exit 1;; esac; done",
    "build:conditional": "for f in '' .min; do { printf '@scope (.pico) {\\n'; cat ./css/pico${f}.css; printf '\\n}\\n'; } > ./css/pico.conditional${f}.css; done",
    "build:layered": "npm run build:layered:css && npm run build:layered:wrap && npm run build:layered:clean",
    "build:layered:css": "rm -rf css/layered && for d in pico blades; do for f in $(find src/$d -name '_*.css' ! -path src/$d/_index.css); do o=css/layered/${f#src/$d/}; mkdir -p ${o%/*} && RAYON_NUM_THREADS=1 lightningcss --bundle $f -o $o || exit 1; done; done",
    "build:layered:wrap": "for f in css/blades.css css/blades.min.css $(find css/layered -name '_*.css'); do case $f in css/blades*) n=${f##*/}; o=css/layered/${n%%.*}.layered.${n#*.};; *) d=${f%/*}; n=${f##*/_}; [ $n = index.css ] && o=$d.css || o=$d/$n;; esac; { printf '@layer blades {\\n'; cat $f; printf '\\n}\\n'; } > $o || exit 1; done",
    "build:layered:clean": "find css/layered -name '_*.css' -delete",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "tag": "next"
  },
  "devDependencies": {
    "lightningcss-cli": "^1.33.0",
    "prettier": "^3.5.3"
  },
  "=== METADATA": "A-Z",
  "bugs": {
    "url": "https://github.com/anyblades/blades/issues"
  },
  "contributors": [
    "Lucas Larroche (https://picocss.com/)",
    "Anton Staroverov (https://blades.ninja/)"
  ],
  "description": "Fully compatible and actively maintained successor to Pico CSS.",
  "homepage": "https://blades.ninja/",
  "keywords": [
    "blades",
    "classless",
    "css-framework",
    "css",
    "dark-mode",
    "dark-theme",
    "lightweight",
    "minimal",
    "native-html",
    "semantic"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anyblades/blades.git"
  },
  "===": "==="
}
